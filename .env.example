# --- The CMS at /app ------------------------------------------------------
# Without both of these, /app is disabled and shows a "not set up" notice.
# The public site does not need them: it falls back to the wording in the code.

# Signs the session cookie. Generate with: openssl rand -hex 32
APP_SESSION_SECRET=

# The content database.
#   local        postgres://you@localhost:5432/jepegomi   (after: createdb jepegomi)
#   production   the Neon connection string
# The first visit to /app creates the tables and offers to create your account.
DATABASE_URL=

# --- Where uploaded photos are written -----------------------------------
# Leave these BLANK for local development: photos are written straight into
# public/photos/kitchen/ on disk.
#
# Set them in PRODUCTION. A serverless filesystem is read-only, so on the live
# site the tool commits photos into the repo instead. Needs a GitHub token with
# "Contents: read and write" on this repo.
GITHUB_TOKEN=
GITHUB_REPO=digitalbrushcreative/jepegomi
GITHUB_BRANCH=main

# --- Email ----------------------------------------------------------------
# Leave the provider keys BLANK locally. With neither set, nothing is sent:
# every message is printed to the terminal instead, subject line, recipients
# and all, so you can read what the site would have posted without posting it.
#
# Set ONE of them in production. Resend is what MAIL.md walks through; Brevo is
# there so the choice is not a one-way door. Resend wins if both are set.
RESEND_API_KEY=
BREVO_API_KEY=

# The envelope sender. It MUST be at a domain whose DNS you control and have
# signed with DKIM — never a gmail.com address, which no third party can sign
# for and which Gmail's own DMARC policy will reject. Replies are steered with
# Reply-To instead, so this address never has to be readable.
MAIL_FROM=Jepegomi <noreply@jepegomi.org>

# Who receives what the site sends inward — enquiries, enrolment, new gifts.
# Comma-separated; the FIRST one is the address printed on the site and the one
# people are told to reply to. Defaults to both of these if left blank.
MAIL_TO=support@jepegomi.org,jepegomi@gmail.com

# Who is copied on what the site sends outward — a giver's receipt, the account
# details somebody asked for. Defaults to jepegomi@gmail.com.
MAIL_COPY=jepegomi@gmail.com

# The logo in the email masthead. Absolute, always — a relative path in an email
# resolves against the reader's webmail host, which is not us. Leave it BLANK in
# production: it defaults to the site's own address (src/lib/site.ts).
#
# Set it LOCALLY, or the preview in /app -> Email points at the live site and
# shows a broken image on a machine that has not deployed yet:
#   MAIL_LOGO_URL=http://localhost:3000/email/jepegomi-logo.png
MAIL_LOGO_URL=

# --- Spam ------------------------------------------------------------------
# reCAPTCHA v3 on the four public forms. Leave BOTH blank and there is no
# captcha at all: no script is loaded, no call is made to Google, and the forms
# fall back to the honeypot and the timer in src/lib/forms.ts, which is what
# `npm run dev` and `npm test` run against. Setting only one of them is the one
# combination that is worse than neither — see src/lib/captcha.ts.
#
# Register the site at https://www.google.com/recaptcha/admin as **v3**, and add
# every hostname you serve from, including the preview deployments. The site key
# is public (it is printed into the page); the secret key is not, and belongs
# here and in the hosting dashboard and nowhere else.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- The account details ---------------------------------------------------
# Deliberately NOT in the repository and NOT in the CMS. See the note at the
# top of src/lib/site.ts: a published account number invites impersonation, and
# one in a CMS text box can be quietly edited by anyone who gets into /app with
# nothing on the page to say it changed. An environment variable can only be
# changed by somebody holding the hosting login.
#
# Free text, sent as written — line breaks are kept. Use \n in Vercel's editor
# or paste real newlines locally. Something like:
#
#   M-Pesa Paybill 123456, account JEPEGOMI
#   Bank: Equity Bank Kenya, Kahawa branch
#   Account name: Jesus People Gospel Ministries
#   Account number: 0123456789
#   SWIFT: EQBLKENA  (for gifts from outside Kenya)
#
# LEAVE IT BLANK until Simon has confirmed the figures. Blank is safe: the
# emails then say he will reply with the details himself, which is what
# happened before the form existed. They never send an empty account number.
GIVING_ACCOUNT_DETAILS=

# --- Pesapal: paying on the site ------------------------------------------
# With these unset, /give is exactly what it was before there was a gateway:
# one button, recording a promise, and Simon replying with account details.
# Set them and a second button appears above it that takes M-Pesa and cards.
#
# The merchant credentials, from the integration email Pesapal sends when the
# account is approved. Never commit the real ones — they belong in .env.local
# locally and in the hosting dashboard in production.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=

# "live" or "sandbox". Sandbox is a different host AND different credentials —
# a demo account from cybqa.pesapal.com, not the merchant one. Set explicitly
# rather than inferred from NODE_ENV, so a staging deployment cannot quietly
# take somebody's real money in a test.
PESAPAL_ENV=sandbox

# What the giver is actually billed. Every figure in the ledger is US cents;
# this is the currency Pesapal is asked for, and the rate converts between the
# two. A Kenyan merchant account is normally KES-only.
#
# The rate is stored on each payment row as it was at the moment of charging,
# so gifts stay reconcilable against a Pesapal statement after you change it.
# Set PESAPAL_CURRENCY=USD and no rate is needed or used — but confirm with
# Pesapal that the account can collect USD before you do.
#
# Without a usable rate for a non-USD currency the pay button does not appear.
# That is deliberate: a missing rate defaulting to 1 would charge a $250 gift
# as KES 250, which is about two dollars, and would do it silently.
PESAPAL_CURRENCY=KES
PESAPAL_USD_RATE=

# Where Pesapal sends givers back to, and where it posts payment notifications.
# Both must be reachable from the internet, so localhost will not do: in
# development run a tunnel and put its https address here. Leave BLANK in
# production — the site's own address (src/lib/site.ts) is what you want.
PESAPAL_CALLBACK_BASE=

# ─── Browser tests ────────────────────────────────────────────────────────────
# The CMS account `npm test` signs in as. The tests drive a real browser against
# a real dev server, so they need a real login — nothing in the suite creates an
# account, because these run against whatever DATABASE_URL is set above.
#
# Leave both blank and the CMS tests skip; the public-site tests still run.
E2E_EMAIL=
E2E_PASSWORD=
